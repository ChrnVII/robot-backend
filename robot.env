# ============ 后端（FastAPI）============
# 环境：dev | prod
ROBOT_ENVIRONMENT=prod
# 机器人身份与运行模式：simulated | hardware
ROBOT_ROBOT_ID=robot-production-001
ROBOT_MODE=hardware
# 允许的跨域来源（逗号分隔，对应旧 FRONTEND_ORIGIN）
ROBOT_CORS_ORIGINS=http://localhost:5173

# 后端自有业务库（用户 / 工作台数据）；生产与 robot-core 共用 PostgreSQL 实例
ROBOT_DATABASE_URL=postgresql+psycopg://robot:Mjl6688!@127.0.0.1:5432/robot_platform
# 机器人业务库（只读检测记录）
ROBOT_ROBOT_DATABASE_URL=postgresql+psycopg://robot:Mjl6688!@127.0.0.1:5432/robot_platform

# 机器人进程网关（Linux 工控机 UDS）
ROBOT_ROBOT_CORE_SOCKET=run/robot-core.sock
ROBOT_SENSOR_WORKER_SOCKET=run/sensor-worker.sock
ROBOT_INSPECTION_WORKER_SOCKET=run/inspection-worker.sock

# 鉴权（生产建议开启；开启后 /api/v1（除 /auth/*）需 Bearer 访问令牌）
ROBOT_AUTH_ENABLED=false
ROBOT_JWT_SECRET=jiayouhuaweijiayouchina
# 首次启动自动创建的管理员（请立即登录修改密码）
ROBOT_DEFAULT_ADMIN_USERNAME=admin
ROBOT_DEFAULT_ADMIN_PASSWORD=123456

# ============ 机器人运行时（robot_core 五进程）============
# PostgreSQL 密码（configs/hardware.yaml 中的 ${ROBOT_DB_PASSWORD} 引用）
ROBOT_DB_PASSWORD=Mjl6688!

# 相机凭据（configs/hardware.yaml 的 ${CAMERA_USERNAME}/${CAMERA_PASSWORD} 引用）
# CAMERA_PASSWORD 为必填，缺失时 robot-core 进程启动会直接报错
CAMERA_USERNAME=admin
CAMERA_PASSWORD=Mjl6688!

# 推理设备：cpu | cuda:0（可选，默认 cpu）
# MODEL_DEVICE=cpu

# ============ 球形摄像头低延迟预览（后端 web 进程）============
# 画面链路：PyAV 解复用 RTSP → WebSocket 透传 Annex-B → 浏览器 WebCodecs 硬解。
# 这里用**子码流 102**（主码流 101 给巡检采集用，分辨率也更高，浏览器硬解更吃力）。
#
# 使用前提：
#   1) 子码流编码必须是 H.264 —— WebCodecs 的 HEVC 支持依赖平台，H.265 不保证能解；
#   2) WebCodecs 只在 HTTPS 或 localhost 下可用：
#      · 开发时 http://localhost:5173 算安全上下文，可直接用；
#      · 用局域网 IP + http 打开会被浏览器禁用解码器，此时页面自动回退到
#        /api/v1/cam/stream 的 JPEG 轮询（功能不中断，只是约 1 帧/秒）。
ROBOT_CAMERA_STREAM_ENABLED=true
ROBOT_CAMERA_STREAM_URL=rtsp://admin:Mjl6688!@192.168.137.64:554/Streaming/Channels/102
ROBOT_CAMERA_STREAM_TRANSPORT=tcp
ROBOT_CAMERA_STREAM_CLIENT_QUEUE=8

# 实时检测叠加：结果只推给前端画框，不落库（留档仍由巡检链路 inference-worker 负责）。
# 保持关闭；本机现有权重是热应激模型 models/hs_detect/weights/best.pt，按需再开。
ROBOT_CAMERA_STREAM_DETECT_ENABLED=false
# ROBOT_CAMERA_STREAM_MODEL=models/hs_detect/weights/best.pt
# ROBOT_CAMERA_STREAM_DETECT_EVERY=1
# ROBOT_CAMERA_STREAM_IMGSZ=640
# ROBOT_CAMERA_STREAM_CONF=0.35
# ROBOT_CAMERA_STREAM_IOU=0.5


