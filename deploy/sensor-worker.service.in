[Unit]
Description=Inspection Robot Sensor Worker（相机 / 热像 / 音频采集，媒体原子落盘）
After=robot-core.service

[Service]
Type=simple
User=__SERVICE_USER__
Group=__SERVICE_USER__
WorkingDirectory=__PROJECT_DIR__
EnvironmentFile=-__PROJECT_DIR__/robot.env
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONPATH=__PROJECT_DIR__
ExecStart=__PROJECT_DIR__/.venv/bin/python -m app.robot_core.processes.sensor_worker --config __PROJECT_DIR__/configs/hardware.yaml
Restart=on-failure
RestartSec=2
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=__PROJECT_DIR__/data __PROJECT_DIR__/run

[Install]
WantedBy=multi-user.target
