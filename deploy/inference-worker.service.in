[Unit]
Description=Inspection Robot Inference Worker（受控模型包 / 隔离推理）
After=robot-core.service

[Service]
Type=simple
User=__SERVICE_USER__
Group=__SERVICE_USER__
WorkingDirectory=__PROJECT_DIR__
EnvironmentFile=-__PROJECT_DIR__/robot.env
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONPATH=__PROJECT_DIR__
# 推理依赖（torch / ultralytics）已随项目依赖一并安装，无需单独同步环境
ExecStart=__PROJECT_DIR__/.venv/bin/python -m app.robot_core.processes.inference_worker --config __PROJECT_DIR__/configs/hardware.yaml
Restart=on-failure
RestartSec=2
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=__PROJECT_DIR__/data __PROJECT_DIR__/run

[Install]
WantedBy=multi-user.target
