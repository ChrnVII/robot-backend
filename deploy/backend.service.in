[Unit]
Description=Inspection Robot Backend（FastAPI：REST / WebSocket / 鉴权 / 编排）
After=network-online.target robot-core.service
Wants=network-online.target

[Service]
Type=simple
User=__SERVICE_USER__
Group=__SERVICE_USER__
WorkingDirectory=__PROJECT_DIR__
EnvironmentFile=-__PROJECT_DIR__/robot.env
Environment=PYTHONUNBUFFERED=1
Environment=ROBOT_PLATFORM_CONFIG=__PROJECT_DIR__/configs/hardware.yaml
Environment=ROBOT_ROBOT_CORE_SOCKET=__PROJECT_DIR__/run/robot-core.sock
Environment=ROBOT_SENSOR_WORKER_SOCKET=__PROJECT_DIR__/run/sensor-worker.sock
Environment=ROBOT_INSPECTION_WORKER_SOCKET=__PROJECT_DIR__/run/inspection-worker.sock
ExecStart=__PROJECT_DIR__/.venv/bin/python -m uvicorn app.main:app --host 0.0.0.0 --port __BACKEND_PORT__
Restart=on-failure
RestartSec=2
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=__PROJECT_DIR__/data __PROJECT_DIR__/run

[Install]
WantedBy=multi-user.target
