[Unit]
Description=Inspection Robot Sensor Worker（相机 / 热像 / 音频采集，媒体原子落盘）
After=robot-core.service

[Service]
Type=simple
User=robot
Group=robot
WorkingDirectory=/opt/inspection-robot
EnvironmentFile=-/etc/inspection-robot/robot.env
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONPATH=/opt/inspection-robot
ExecStart=/opt/inspection-robot/.venv/bin/python -m app.robot_core.processes.sensor_worker --config /opt/inspection-robot/configs/hardware.yaml
Restart=on-failure
RestartSec=2
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/opt/inspection-robot/data /opt/inspection-robot/run

[Install]
WantedBy=multi-user.target
