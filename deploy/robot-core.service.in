[Unit]
Description=Inspection Robot Core（设备唯一写入者 / 租约 / 安全 / 状态）
After=local-fs.target systemd-udev-settle.service

[Service]
Type=simple
User=__SERVICE_USER__
Group=__SERVICE_USER__
# /dev/ttyS0 属于 dialout；缺这一行串口直读会 Permission denied（环境数据拿不到）。
SupplementaryGroups=dialout
WorkingDirectory=__PROJECT_DIR__
EnvironmentFile=-__PROJECT_DIR__/robot.env
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONPATH=__PROJECT_DIR__
ExecStart=__PROJECT_DIR__/.venv/bin/python -m app.robot_core.processes.robot_core --config __PROJECT_DIR__/configs/hardware.yaml
Restart=on-failure
RestartSec=2
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=__PROJECT_DIR__/data __PROJECT_DIR__/run

[Install]
WantedBy=multi-user.target
