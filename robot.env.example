# ============ 后端（FastAPI）============
# 环境：dev | prod
ROBOT_ENVIRONMENT=prod
# 机器人身份与运行模式：simulated | hardware
ROBOT_ROBOT_ID=robot-production-001
ROBOT_MODE=hardware
# 允许的跨域来源（逗号分隔，对应旧 FRONTEND_ORIGIN）
ROBOT_CORS_ORIGINS=http://localhost:5173

# 后端自有业务库（用户 / 工作台数据）；生产与 robot-core 共用 PostgreSQL 实例
ROBOT_DATABASE_URL=postgresql+psycopg://robot:CHANGE_ME@127.0.0.1:5432/robot_platform
# 机器人业务库（只读检测记录）
ROBOT_ROBOT_DATABASE_URL=postgresql+psycopg://robot:CHANGE_ME@127.0.0.1:5432/robot_platform

# 机器人进程网关（Linux 工控机 UDS）
ROBOT_ROBOT_CORE_SOCKET=run/robot-core.sock
ROBOT_SENSOR_WORKER_SOCKET=run/sensor-worker.sock
ROBOT_INSPECTION_WORKER_SOCKET=run/inspection-worker.sock

# 鉴权（生产建议开启；开启后 /api/v1（除 /auth/*）需 Bearer 访问令牌）
ROBOT_AUTH_ENABLED=true
ROBOT_JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET
# 首次启动自动创建的管理员（请立即登录修改密码）
ROBOT_DEFAULT_ADMIN_USERNAME=admin
ROBOT_DEFAULT_ADMIN_PASSWORD=CHANGE_ME_ON_FIRST_LOGIN

# ============ 机器人运行时（robot_core 五进程）============
# PostgreSQL 密码（configs/hardware.yaml 中的 ${ROBOT_DB_PASSWORD} 引用）
ROBOT_DB_PASSWORD=CHANGE_ME

# 相机凭据（configs/hardware.yaml 的 ${CAMERA_USERNAME}/${CAMERA_PASSWORD} 引用）
# CAMERA_PASSWORD 为必填，缺失时 robot-core 进程启动会直接报错
CAMERA_USERNAME=admin
CAMERA_PASSWORD=CHANGE_ME

# 推理设备：cpu | cuda:0（可选，默认 cpu）
# MODEL_DEVICE=cpu
