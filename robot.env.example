# ============ 后端（FastAPI）============
# 环境：dev | prod
ROBOT_ENVIRONMENT=prod
# 机器人身份与运行模式：simulated | hardware
ROBOT_ROBOT_ID=robot-production-001
ROBOT_MODE=hardware
# 允许的跨域来源（逗号分隔，对应旧 FRONTEND_ORIGIN）
ROBOT_CORS_ORIGINS=http://localhost:5173

# 后端业务库（用户 / 工作台数据 + 只读检测记录）。
# 各进程共用同一实例；生产可使用不同受限角色，见 deploy/README.md。
ROBOT_DATABASE_URL=postgresql+psycopg://robot:CHANGE_ME@127.0.0.1:5432/robot_platform
# 开发默认 true；生产建议预先迁移后关闭自动迁移。
ROBOT_AUTO_MIGRATE=false
# ROBOT_MIGRATION_DATABASE_URL=postgresql+psycopg://robot_owner:CHANGE_ME@127.0.0.1:5432/robot_platform
# ROBOT_CORE_DATABASE_URL=postgresql+psycopg://robot_control:CHANGE_ME@127.0.0.1:5432/robot_platform
# ROBOT_PERCEPTION_DATABASE_URL=postgresql+psycopg://robot_perception:CHANGE_ME@127.0.0.1:5432/robot_platform
# ROBOT_SYNC_DATABASE_URL=postgresql+psycopg://robot_sync:CHANGE_ME@127.0.0.1:5432/robot_platform
# 默认不启同步；此开关同时覆盖 YAML sync.enabled。
ROBOT_SYNC_ENABLED=false

# 机器人进程网关（Linux 工控机 UDS）
ROBOT_ROBOT_CORE_SOCKET=run/robot-core.sock
ROBOT_SENSOR_WORKER_SOCKET=run/sensor-worker.sock
ROBOT_INSPECTION_WORKER_SOCKET=run/inspection-worker.sock

# 鉴权（生产建议开启；开启后 /api/v1（除 /auth/*）需 Bearer 访问令牌）
ROBOT_AUTH_ENABLED=true
ROBOT_JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET
# 首次启动自动创建的管理员（请立即登录修改密码）
ROBOT_DEFAULT_ADMIN_USERNAME=admin
ROBOT_DEFAULT_ADMIN_PASSWORD=CHANGE_ME_ON_FIRST_LOGIN

# ============ 机器人运行时（控制 + 感知）============
# PostgreSQL 密码（configs/hardware.yaml 中的 ${ROBOT_DB_PASSWORD} 引用）
ROBOT_DB_PASSWORD=CHANGE_ME

# 相机凭据（configs/hardware.yaml 的 ${CAMERA_USERNAME}/${CAMERA_PASSWORD} 引用）
# CAMERA_PASSWORD 为必填，缺失时 robot-core 进程启动会直接报错
CAMERA_USERNAME=admin
CAMERA_PASSWORD=CHANGE_ME

# 推理设备：cpu | cuda:0（可选，默认 cpu）
# MODEL_DEVICE=cpu

# ============ 球形摄像头低延迟预览（后端 web 进程）============
# 画面链路：PyAV 解复用 RTSP → WebSocket 透传 Annex-B → 浏览器 WebCodecs 硬解。
# 不配置地址时整条链路静默降级，前端自动回退到 /api/v1/cam/stream 的 JPEG 轮询。
#
# 注意：
#   1) 建议使用**子码流**（海康 .../Streaming/Channels/102）：主码流分辨率太高，
#      浏览器硬解与内网带宽都更吃力；
#   2) 子码流编码请设为 H.264。WebCodecs 的 HEVC 支持依赖平台，H.265 不保证能解；
#   3) WebCodecs 只在 **HTTPS 或 localhost** 下可用。用局域网 IP + http 打开页面时
#      浏览器会直接禁用解码器，此时页面会退回 JPEG 轮询。生产请给后端配
#      TLS（uvicorn --ssl-certfile/--ssl-keyfile）或经 HTTPS 反向代理访问；
#   4) 密码含 @ : / ? # 时必须做 URL 百分号编码。
ROBOT_CAMERA_STREAM_ENABLED=true
# ROBOT_CAMERA_STREAM_URL=rtsp://admin:CHANGE_ME@192.168.137.64:554/Streaming/Channels/102
ROBOT_CAMERA_STREAM_TRANSPORT=tcp
# 每个浏览器订阅者的帧队列上限：溢出即丢并等下一个关键帧重同步
ROBOT_CAMERA_STREAM_CLIENT_QUEUE=8

# 实时检测叠加（可选）：结果只推给前端画框，**不写入数据库** ——
# 需要留档的检测记录仍由巡检链路（inference-worker）落库。
ROBOT_CAMERA_STREAM_DETECT_ENABLED=false
# ROBOT_CAMERA_STREAM_MODEL=models/best.pt
# ROBOT_CAMERA_STREAM_DETECT_EVERY=1
# ROBOT_CAMERA_STREAM_IMGSZ=640
# ROBOT_CAMERA_STREAM_CONF=0.35
# ROBOT_CAMERA_STREAM_IOU=0.5
